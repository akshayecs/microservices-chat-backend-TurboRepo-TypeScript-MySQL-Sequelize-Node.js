# ------------------------------------------
# TurboRepo / Monorepo specific
# ------------------------------------------
turbo/
.vscode/
.idea/

# Build output for each service
services/*/dist/
services/*/build/

#ignore it
node_modules/

# Node modules inside each service
services/*/node_modules/

# Local environment files (never commit)
services/*/.env
services/*/.env.*
!.env.example
!services/*/.env.example

# Local log files for each service
services/*/*.log

# Docker build artifacts
**/Dockerfile.prod
**/docker-compose.override.yml

# Local data directories (Redis, MySQL, Kafka running locally)
data/
redis-data/
mysql-data/
kafka-data/
zookeeper-data/
